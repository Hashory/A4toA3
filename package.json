		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=10.34.9"
	},
	"packageManager": "pnpm@10.34.9"
