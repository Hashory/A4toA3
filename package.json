{
	"name": "a4toa3",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"build": "svelte-kit sync && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"dev": "vite dev",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint .",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"test": "vitest run"
	},
	"dependencies": {
		"pdf-lib": "^1.17.1",
		"ts-custom-error": "^3.3.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.0",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.72.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=10.33.0"
	},
	"packageManager": "pnpm@10.33.0"
